# Скопируйте в .env локально. Реальные ключи не добавляйте в Git.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_REVIEW_MODEL=anthropic/claude-sonnet-4.5
# Необязательные маршруты: пустое значение использует OPENROUTER_MODEL.
# interview_simulator → RESPONDENT; analyst и ux_reviewer → ANALYST.
# Укажите доступные ID из каталога OpenRouter; роли вызываются только по задаче.
OPENROUTER_RESPONDENT_MODEL=
OPENROUTER_ANALYST_MODEL=
# Все расходы учитываются в USD. Бюджет проекта задаётся в init --budget.
